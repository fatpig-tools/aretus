# Public site URL (used for canonical links, sitemap and structured data)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity: leave the project ID empty to run on the local content brief
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
# Viewer token: live content, drafts and visual editing
SANITY_API_READ_TOKEN=
# Editor token: server-only, used to store contact-form enquiries and to seed content
SANITY_API_WRITE_TOKEN=

# Optional: re-downloading source 3D models / finding stock photos
SKETCHFAB_API_TOKEN=
PEXELS_API_KEY=
